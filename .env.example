# Copy to .env. With the defaults (Ollama + local embeddings) no keys are needed at all.

# Only if generation.provider: groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
# Only if generation.provider: anthropic
ANTHROPIC_API_KEY=
# Only if embedding.provider: voyage
VOYAGE_API_KEY=
# Optional: use a different config file (e.g. for eval experiments)
# RAG_CONFIG=config.experiment.yaml
